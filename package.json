{
  "name": "forja-app",
  "version": "4.13.1",
  "private": true,
  "description": "Forja: app de treino de musculação (web, PWA e Android via Capacitor)",
  "scripts": {
    "dev": "npx --yes http-server www -p 8080 -c-1",
    "test:rules": "firebase emulators:exec --only firestore \"node tests/firestore.rules.test.js\"",
    "rules:deploy": "firebase deploy --only firestore:rules,firestore:indexes",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capacitor-community/keep-awake": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "firebase": "^13.2.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-tools": "^15.34.2"
  },
  "engines": {
    "node": ">=18"
  }
}
