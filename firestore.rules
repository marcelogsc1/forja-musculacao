rules_version = '2';

// Regras do Firestore para o Forja
// --------------------------------------------------------------------------
// Estrutura:  users/{uid}/records/{tipo}__{id}
//   { type, id, data, deleted, updatedAt (Timestamp do aparelho), serverAt (horário do servidor) }
//
// O que estas regras garantem:
//   1. Cada pessoa só lê e grava os próprios dados (uid do login = uid do caminho),
//      e só depois de CONFIRMAR O E-MAIL (conta com e-mail real). Contas anônimas ficam de fora.
//   2. Nada fora de users/{uid}/records pode ser lido ou gravado.
//   3. Formato de cada documento conferido: campos permitidos, tipos, tamanhos e id coerente com o caminho.
//   4. "A alteração mais recente vence": uma gravação com updatedAt mais antigo que a salva é recusada.
//   5. serverAt é sempre o horário do servidor (o aparelho não consegue forjar), base da sincronização incremental.
//   6. O dono pode apagar os próprios documentos (exclusão de conta exigida pela Play Store).
// Teste com: npm run test:rules  (emulador do Firebase)

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- autenticação ----------
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // e-mail confirmado e login por e-mail/senha ou Google (bloqueia contas anônimas)
    function realAccount() {
      return request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider in ['password', 'google.com'];
    }
    function isVerifiedOwner(uid) { return isOwner(uid) && realAccount(); }

    // ---------- ajudantes de validação ----------
    function optStr(m, k, n) { return !(k in m) || m[k] == null || (m[k] is string && m[k].size() <= n); }
    function optNum(m, k, lo, hi) { return !(k in m) || m[k] == null || ((m[k] is int || m[k] is float) && m[k] >= lo && m[k] <= hi); }
    function optList(m, k, n) { return !(k in m) || m[k] == null || (m[k] is list && m[k].size() <= n); }
    function optBool(m, k) { return !(k in m) || m[k] == null || m[k] is bool; }
    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    function validId(t, i) {
      return i is string && i.size() >= 1 && i.size() <= 120 && i.matches('^[A-Za-z0-9_.~:@+-]+$')
        && ((t != 'profile' && t != 'prefs' && t != 'avatar') || i == 'me')
        && (t != 'measurement' || isDate(i));
    }

    // ---------- conteúdo de cada tipo ----------
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'birth', 'height', 'goal', 'level', 'createdAt', 'sex', 'photo'])
        && optStr(d, 'name', 60) && optStr(d, 'birth', 10) && optStr(d, 'height', 6)
        && optStr(d, 'goal', 30) && optStr(d, 'level', 30) && optStr(d, 'createdAt', 40)
        && optStr(d, 'sex', 20) && optStr(d, 'photo', 200);
    }
    function validPrefs(d) {
      return d.keys().hasOnly(['prefs', 'active', 'v'])
        && d.prefs is map && d.prefs.size() <= 40
        && optStr(d, 'active', 120) && optNum(d, 'v', 0, 1000);
    }
    function validRoutine(d, i) {
      return d.size() <= 20 && d.keys().hasAll(['id', 'nome', 'workouts'])
        && d.id == i && d.nome is string && d.nome.size() <= 80
        && optStr(d, 'desc', 600) && optStr(d, 'from', 120) && optNum(d, 'ord', 0, 10000)
        && d.workouts is list && d.workouts.size() <= 30;
    }
    function validExercise(d) {
      return d.size() <= 20 && d.keys().hasAll(['n'])
        && d.n is string && d.n.size() >= 1 && d.n.size() <= 80
        && optStr(d, 'm', 30) && optStr(d, 'e', 30) && optStr(d, 'p', 30)
        && optList(d, 'pri', 20) && optList(d, 'sec', 20) && optList(d, 'd', 20);
    }
    function validMeasurement(d, i) {
      return d.keys().hasOnly(['date', 'kg', 'cintura', 'braco', 'peito', 'coxa', 'quadril', 'gordura', 'pescoco'])
        && d.date == i
        && optNum(d, 'kg', 0, 500) && optNum(d, 'cintura', 0, 300) && optNum(d, 'braco', 0, 300)
        && optNum(d, 'peito', 0, 300) && optNum(d, 'coxa', 0, 300) && optNum(d, 'quadril', 0, 300)
        && optNum(d, 'gordura', 0, 100) && optNum(d, 'pescoco', 0, 300);
    }
    function validMedia(d) {
      return d.keys().hasOnly(['asset']) && d.asset is string && d.asset.size() <= 200;
    }
    // foto do perfil: JPEG reduzido no aparelho (256 px), guardado como data URL de até 60 mil caracteres
    function validAvatar(d) {
      return d.keys().hasOnly(['img', 'at'])
        && d.img is string && d.img.size() <= 60000 && d.img.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && optStr(d, 'at', 40);
    }
    function validSession(d, i) {
      return d.size() <= 40 && d.keys().hasAll(['id', 'status', 'date', 'items'])
        && d.id == i && d.status in ['open', 'draft', 'done'] && isDate(d.date)
        && d.items is list && d.items.size() <= 80
        && optStr(d, 'wname', 80) && optStr(d, 'note', 2000) && optStr(d, 'routine', 120) && optStr(d, 'workout', 120)
        && optStr(d, 'startedAt', 40) && optStr(d, 'finishedAt', 40) && optStr(d, 'updatedAt', 40)
        && optNum(d, 'dur', 0, 1440) && optNum(d, 'cor', 0, 50)
        && optBool(d, 'free') && optBool(d, 'quick');
    }
    function validData(t, i, d) {
      return (t == 'profile' && validProfile(d))
        || (t == 'prefs' && validPrefs(d))
        || (t == 'routine' && validRoutine(d, i))
        || (t == 'exercise' && validExercise(d))
        || (t == 'measurement' && validMeasurement(d, i))
        || (t == 'media' && validMedia(d))
        || (t == 'avatar' && validAvatar(d))
        || (t == 'session' && validSession(d, i));
    }

    // ---------- documento de registro ----------
    function validRecord(rid) {
      let r = request.resource.data;
      return r.keys().hasOnly(['type', 'id', 'data', 'deleted', 'updatedAt', 'serverAt'])
        && r.keys().hasAll(['type', 'id', 'data', 'deleted', 'updatedAt', 'serverAt'])
        && r.type in ['profile', 'prefs', 'routine', 'exercise', 'measurement', 'media', 'avatar', 'session']
        && validId(r.type, r.id)
        && rid == r.type + '__' + r.id
        && r.deleted is bool
        && r.updatedAt is timestamp
        && r.updatedAt > timestamp.date(2024, 1, 1)
        && r.updatedAt <= request.time + duration.value(1, 'd')
        && r.serverAt == request.time
        && ((r.deleted == true && r.data == null)
            || (r.deleted == false && r.data is map && validData(r.type, r.id, r.data)));
    }

    match /users/{uid}/records/{rid} {
      allow get, list: if isVerifiedOwner(uid);
      allow create: if isVerifiedOwner(uid) && validRecord(rid);
      allow update: if isVerifiedOwner(uid) && validRecord(rid)
        && request.resource.data.type == resource.data.type
        && request.resource.data.id == resource.data.id
        && request.resource.data.updatedAt >= resource.data.updatedAt;
      // apagar a própria conta funciona mesmo sem e-mail confirmado
      allow delete: if isOwner(uid);
    }

    // Todo o resto é bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
